# Local configuration template.  Copy this file to ".env" in this same folder
# and fill in the values.  settings.py auto-loads .env at startup; real
# environment variables take precedence over .env values.  (.env is gitignored.)

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

RAG_MIN_RRF_SCORE=0

# Telephony stays simulated unless you explicitly opt in.
TELEPHONY_MODE=simulator
# TELEPHONY_MODE=sandbox
# Generate a unique 32+ character value in your deployment secret manager.
# USSD_SANDBOX_CALLBACK_TOKEN=

# ---------------------------------------------------------------------------
# Interest re-explanation providers  (REEXPLAIN_MODE = disabled | fixture | live)
# "live" tries providers in this order: OpenRouter (ox-alpha) -> Anthropic -> OpenAI.
# Any single key is enough; blank slots are skipped.
# ---------------------------------------------------------------------------
# REEXPLAIN_MODE=live

# Slot 1 - OpenRouter (primary; OpenAI-compatible endpoint)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=ox-alpha
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Slot 2 - Anthropic (backup; Claude Haiku by default here)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Slot 3 - direct OpenAI / open-weight fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
